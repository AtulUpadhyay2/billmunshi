# .env.production
VITE_API_BASE_URL=https://billmunshi.com/api/v1
VITE_API_TIMEOUT=30000

# reCAPTCHA v2 site key for billmunshi.com. This MUST be filled in before
# a production build — an empty value ships the signup and demo forms
# with no bot protection. The matching secret goes in the backend's
# RECAPTCHA_SECRET_KEY; the two are useless apart.
VITE_RECAPTCHA_SITE_KEY=
