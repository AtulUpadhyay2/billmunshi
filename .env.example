VITE_API_BASE_URL=https://billmunshi.com/api/v1
VITE_API_TIMEOUT=30000

# Google reCAPTCHA v2 ("I'm not a robot") site key for the /register and
# /book-demo forms. Create a v2 checkbox key pair at
# https://www.google.com/recaptcha/admin, list billmunshi.com and
# localhost as allowed domains, then put the SITE key here and the
# SECRET key in the backend's RECAPTCHA_SECRET_KEY.
#
# Leave empty to skip the widget entirely (dev default). The backend
# skips verification too when its secret is unset, so the forms keep
# working — but an empty value in production means no bot protection.
VITE_RECAPTCHA_SITE_KEY=
